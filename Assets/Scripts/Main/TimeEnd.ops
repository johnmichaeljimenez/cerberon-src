@TIMEEND

WAIT 1
PLAYAUDIO "vehicle/horn" "car-sfx" FALSE 100
WAIT 0.3
PLAYAUDIO "vehicle/horn" "car-sfx" FALSE 100
WAIT 1

PLAYAUDIO "vehicle/horn" "car-sfx" FALSE 100
WAIT 0.3
PLAYAUDIO "vehicle/horn" "car-sfx" FALSE 100
WAIT 1

PLAYAUDIO "phone" "<null>" TRUE
SAY WADE "Yo Seth! Open the gate, man!"

SWITCHLIGHT "Main" FALSE
WAIT 0.5
SAY SETH "Ah, shit."
WAIT 0.5

SAY WADE "What's going on there?"
SAY SETH "Power's out again!"
SAY WADE "Alright I'll wait here. Roaches for sure busted the breaker at the back out there."

WAIT 0.5
SETACTIVE "PowerSwitch" TRUE
SAVE TimeEnd FALSE